{
  "openapi": "3.1.0",
  "info": {
    "title": "사내 요청 대장 로컬 시제품 API",
    "version": "0.1.0-draft",
    "description": "PO 검토용 설계. spec.md 및 contracts.md/storage.md와 함께 수락한다. 엄격 UTF-8·중복 JSON 키·버전 lexical 정수·오류 우선순위 등 스키마만으로 표현하지 않은 검증은 contracts.md가 정본이다. 인증·감사는 수락한 합성 데이터 시제품 범위에서 제외. feature flag는 인증이 아니다."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "8765",
          "description": "CLI --port 1–65535"
        }
      }
    }
  ],
  "security": [],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "DB와 무관한 생존 확인",
        "description": "OFF에서도 동작. query/body 없음. Origin은 거부.",
        "responses": {
          "200": {
            "description": "프로세스 응답 가능",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "origin_not_allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/requests": {
      "get": {
        "operationId": "listRequests",
        "summary": "요청 목록 조회",
        "parameters": [
          {
            "name": "owner",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "공백만인 값 거부. 대소문자 구분 정확 일치. 생략은 null 포함."
            },
            "description": "최대 한 번. 빈 값·중복·알 수 없는 쿼리 키는 400."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Status"
            },
            "description": "최대 한 번. 빈 값·중복·알 수 없는 쿼리 키는 400."
          }
        ],
        "responses": {
          "200": {
            "description": "필터 AND, ID BINARY 오름차순. 빈 배열 가능.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "origin_not_allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "408": {
            "description": "request_timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "feature_disabled / store_unavailable / store_busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/requests/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/RequestId"
          },
          "description": "UTF-8 percent encoding, slash 포함 시 %2F. path 분리 후 한 번만 decode."
        }
      ],
      "get": {
        "operationId": "getRequest",
        "summary": "요청 단건 조회",
        "responses": {
          "200": {
            "description": "현재 요청",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "origin_not_allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found 또는 route_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "408": {
            "description": "request_timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "feature_disabled / store_unavailable / store_busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateRequest",
        "summary": "버전 확인 후 담당자·상태 변경",
        "parameters": [
          {
            "name": "Content-Length",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "description": "wire에서는 중복 없는 십진 정수. Transfer-Encoding 불허."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Patch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "커밋한 요청 또는 현재 버전의 동일 값. 변경 때만 버전 +1.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "origin_not_allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found 또는 route_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "408": {
            "description": "request_timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "version_conflict / invalid_transition / version_exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "411": {
            "description": "length_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "unsupported_media_type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "feature_disabled / store_unavailable / store_busy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RequestId": {
        "type": "string",
        "minLength": 1,
        "description": "UTF-8 scalar 문자열. Python str.strip() 결과가 빈 값이면 거부. trim/정규화하지 않음."
      },
      "Owner": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "description": "문자열이면 공백만인 값 거부. 원문·대소문자 보존."
      },
      "Status": {
        "type": "string",
        "enum": [
          "open",
          "done"
        ]
      },
      "Version": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9223372036854775807,
        "description": "wire JSON에서 bool·실수 표기는 거부(1.0도 거부). 실제 변경 때만 +1."
      },
      "Request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "owner",
          "status",
          "version"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "title": {
            "$ref": "#/components/schemas/RequestId"
          },
          "owner": {
            "$ref": "#/components/schemas/Owner"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          }
        }
      },
      "Patch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "$ref": "#/components/schemas/Version"
          },
          "owner": {
            "$ref": "#/components/schemas/Owner"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "anyOf": [
          {
            "required": [
              "owner"
            ]
          },
          {
            "required": [
              "status"
            ]
          }
        ],
        "description": "owner/status 중 하나 이상. 누락은 유지, owner null은 해제. 오래된 버전은 동일 값도 충돌. done→open 거부."
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          }
        }
      },
      "ListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requests"
        ],
        "properties": {
          "requests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Request"
            }
          }
        }
      },
      "ItemResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request"
        ],
        "properties": {
          "request": {
            "$ref": "#/components/schemas/Request"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "feature_disabled",
                  "invalid_input",
                  "not_found",
                  "route_not_found",
                  "method_not_allowed",
                  "origin_not_allowed",
                  "version_conflict",
                  "invalid_transition",
                  "length_required",
                  "payload_too_large",
                  "unsupported_media_type",
                  "request_timeout",
                  "store_unavailable",
                  "store_busy",
                  "version_exhausted",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string",
                "description": "contracts.md 오류 표의 코드별 고정 한국어 문구."
              }
            }
          }
        }
      }
    }
  }
}
