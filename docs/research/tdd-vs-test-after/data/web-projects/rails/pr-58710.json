      "filename": "activesupport/lib/active_support/values/time_zone.rb",
      "status": "modified",
      "additions": 10,
      "deletions": 0,
      "changes": 10,
      "blob_url": "https://github.com/rails/rails/blob/bc4924acd1932bf030d3d288f52f775ac61ad715/activesupport%2Flib%2Factive_support%2Fvalues%2Ftime_zone.rb",
      "raw_url": "https://github.com/rails/rails/raw/bc4924acd1932bf030d3d288f52f775ac61ad715/activesupport%2Flib%2Factive_support%2Fvalues%2Ftime_zone.rb",
      "contents_url": "https://api.github.com/repos/rails/rails/contents/activesupport%2Flib%2Factive_support%2Fvalues%2Ftime_zone.rb?ref=bc4924acd1932bf030d3d288f52f775ac61ad715",
      "patch": "@@ -279,6 +279,16 @@ def clear # :nodoc:\n         @zones_map = nil\n       end\n \n+      def make_shareable! # :nodoc:\n+        all\n+        TZInfo::Timezone.all_identifiers.each { |identifier| self[identifier] }\n+        TZInfo::Country.all_codes.each { |code| country_zones(code) }\n+\n+        @lazy_zones_map = ActiveSupport::Ractors.make_shareable(@lazy_zones_map.each_pair.to_h)\n+        @country_zones  = ActiveSupport::Ractors.make_shareable(@country_zones.each_pair.to_h)\n+        ActiveSupport::Ractors.make_shareable(MAPPING)\n+      end\n+\n       private\n         def load_country_zones(code)\n           country = TZInfo::Country.get(code)"
    },
    {
      "sha": "b8c928dbbe8c419217fd1ab60e1d620ebe4ad759",
      "filename": "activesupport/test/time_zone_test.rb",
      "status": "modified",
      "additions": 16,
      "deletions": 0,
      "changes": 16,
      "blob_url": "https://github.com/rails/rails/blob/bc4924acd1932bf030d3d288f52f775ac61ad715/activesupport%2Ftest%2Ftime_zone_test.rb",
      "raw_url": "https://github.com/rails/rails/raw/bc4924acd1932bf030d3d288f52f775ac61ad715/activesupport%2Ftest%2Ftime_zone_test.rb",
      "contents_url": "https://api.github.com/repos/rails/rails/contents/activesupport%2Ftest%2Ftime_zone_test.rb?ref=bc4924acd1932bf030d3d288f52f775ac61ad715",
      "patch": "@@ -1004,3 +1004,19 @@ def test_country_zones_include_pacific_time_canada_and_alberta\n     assert_not_includes ca_zones.map(&:name), \"America/Edmonton\"\n   end\n end\n+\n+class TimeZoneRactorTest < ActiveSupport::TestCase\n+  include ActiveSupport::Testing::Isolation\n+  include ActiveSupport::Testing::RactorsAssertions\n+\n+  def test_zones_are_usable_from_a_non_main_ractor_once_shared\n+    ActiveSupport::TimeZone.make_shareable!\n+\n+    assert_equal \"Europe/Paris\", on_ractor { ActiveSupport::TimeZone[\"Paris\"].tzinfo.name }\n+    assert_equal \"Europe/Paris\", on_ractor { ActiveSupport::TimeZone[\"Europe/Paris\"].tzinfo.name }\n+    assert_equal 3600, on_ractor { ActiveSupport::TimeZone[\"Paris\"].utc_offset }\n+    assert_equal \"2026-07-01 14:00:00 +0200\", on_ractor { Time.utc(2026, 7, 1, 12).in_time_zone(\"Paris\").to_s }\n+    assert_equal \"Asia/Tokyo\", on_ractor { Time.use_zone(\"Tokyo\") { Time.zone.tzinfo.name } }\n+    assert_includes on_ractor { ActiveSupport::TimeZone.country_zones(:fr).map(&:name) }, \"Paris\"\n+  end\n+end"
    },
    {
      "sha": "4d13b188d045ffa7463fa2ff799f45e6b55f9f2c",
      "filename": "railties/lib/rails/application.rb",
      "status": "modified",
      "additions": 1,
      "deletions": 0,
      "changes": 1,
      "blob_url": "https://github.com/rails/rails/blob/bc4924acd1932bf030d3d288f52f775ac61ad715/railties%2Flib%2Frails%2Fapplication.rb",
      "raw_url": "https://github.com/rails/rails/raw/bc4924acd1932bf030d3d288f52f775ac61ad715/railties%2Flib%2Frails%2Fapplication.rb",
      "contents_url": "https://api.github.com/repos/rails/rails/contents/railties%2Flib%2Frails%2Fapplication.rb?ref=bc4924acd1932bf030d3d288f52f775ac61ad715",
      "patch": "@@ -674,6 +674,7 @@ def ractorize! # :nodoc:\n       @autoloaders, @reloaders, @routes_reloader = nil, nil, nil\n \n       ActionView::PathRegistry.make_shareable! if defined?(ActionView::PathRegistry)\n+      ActiveSupport::TimeZone.make_shareable!\n \n       if defined?(AbstractController::Base)\n         [AbstractController::Base, *AbstractController::Base.descendants].each do |controller|"
    }
  ],
