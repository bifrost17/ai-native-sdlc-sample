      "status": "modified",
      "additions": 3,
      "deletions": 8,
      "changes": 11,
      "blob_url": "https://github.com/react/react/blob/f851a61895724c482a9a6761589ba217d9da6899/compiler%2Fcrates%2Freact_compiler_optimization%2Fsrc%2Fconstant_propagation.rs",
      "raw_url": "https://github.com/react/react/raw/f851a61895724c482a9a6761589ba217d9da6899/compiler%2Fcrates%2Freact_compiler_optimization%2Fsrc%2Fconstant_propagation.rs",
      "contents_url": "https://api.github.com/repos/react/react/contents/compiler%2Fcrates%2Freact_compiler_optimization%2Fsrc%2Fconstant_propagation.rs?ref=f851a61895724c482a9a6761589ba217d9da6899",
      "patch": "@@ -1098,14 +1098,9 @@ fn js_to_int32(n: f64) -> i32 {\n     if n.is_nan() || n.is_infinite() || n == 0.0 {\n         return 0;\n     }\n-    // Truncate, then wrap to 32 bits\n-    let int64 = (n.trunc() as i64) & 0xFFFFFFFF;\n-    // Reinterpret as signed i32\n-    if int64 >= 0x80000000 {\n-        (int64 as u32) as i32\n-    } else {\n-        int64 as i32\n-    }\n+    // Rust saturates f64-to-i64 conversions, but JavaScript ToInt32 wraps modulo 2^32.\n+    let wrapped = n.trunc().rem_euclid((1_u64 << 32) as f64);\n+    wrapped as u32 as i32\n }\n \n /// ECMAScript ToUint32: convert f64 to u32 with modular (wrapping) semantics."
    },
    {
      "sha": "a95bed470606db47b66ad1466d80c2beccbce857",
      "filename": "compiler/packages/babel-plugin-react-compiler/src/__tests__/fixtures/compiler/constant-propagation-bit-ops-large-numbers.expect.md",
      "status": "added",
      "additions": 67,
      "deletions": 0,
      "changes": 67,
      "blob_url": "https://github.com/react/react/blob/f851a61895724c482a9a6761589ba217d9da6899/compiler%2Fpackages%2Fbabel-plugin-react-compiler%2Fsrc%2F__tests__%2Ffixtures%2Fcompiler%2Fconstant-propagation-bit-ops-large-numbers.expect.md",
      "raw_url": "https://github.com/react/react/raw/f851a61895724c482a9a6761589ba217d9da6899/compiler%2Fpackages%2Fbabel-plugin-react-compiler%2Fsrc%2F__tests__%2Ffixtures%2Fcompiler%2Fconstant-propagation-bit-ops-large-numbers.expect.md",
      "contents_url": "https://api.github.com/repos/react/react/contents/compiler%2Fpackages%2Fbabel-plugin-react-compiler%2Fsrc%2F__tests__%2Ffixtures%2Fcompiler%2Fconstant-propagation-bit-ops-large-numbers.expect.md?ref=f851a61895724c482a9a6761589ba217d9da6899",
      "patch": "@@ -0,0 +1,67 @@\n+\n+## Input\n+\n+```javascript\n+import {Stringify} from 'shared-runtime';\n+\n+function foo() {\n+  return (\n+    <Stringify\n+      value={[\n+        (2 ** 64) | 0,\n+        -(2 ** 64) | 0,\n+        1e21 | 0,\n+        -1e21 | 0,\n+        1e21 & -1,\n+        1e21 ^ 0,\n+        1e21 >>> 0,\n+        (2 ** 64) >> 4,\n+        1e21 << 1,\n+      ]}\n+    />\n+  );\n+}\n+\n+export const FIXTURE_ENTRYPOINT = {\n+  fn: foo,\n+  params: [],\n+  isComponent: false,\n+};\n+\n+```\n+\n+## Code\n+\n+```javascript\n+import { c as _c } from \"react/compiler-runtime\";\n+import { Stringify } from \"shared-runtime\";\n+\n+function foo() {\n+  const $ = _c(1);\n+  let t0;\n+  if ($[0] === Symbol.for(\"react.memo_cache_sentinel\")) {\n+    t0 = (\n+      <Stringify\n+        value={[\n+          0, 0, -559939584, 559939584, -559939584, -559939584, 3735027712, 0,\n+          -1119879168,\n+        ]}\n+      />\n+    );\n+    $[0] = t0;\n+  } else {\n+    t0 = $[0];\n+  }\n+  return t0;\n+}\n+\n+export const FIXTURE_ENTRYPOINT = {\n+  fn: foo,\n+  params: [],\n+  isComponent: false,\n+};\n+\n+```\n+      \n+### Eval output\n+(kind: ok) <div>{\"value\":[0,0,-559939584,559939584,-559939584,-559939584,3735027712,0,-1119879168]}</div>\n\\ No newline at end of file"
    },
